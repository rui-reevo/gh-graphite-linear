{
  "manifest_version": 3,
  "name": "Graphite ↔ GitHub",
  "version": "2.1.1",
  "description": "Bidirectional bridge between Graphite and GitHub pull requests — open either side from the other.",
  "content_scripts": [
    {
      "matches": ["https://app.graphite.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["github-content.js"],
      "css": ["github-content.css"],
      "run_at": "document_idle"
    }
  ]
}
