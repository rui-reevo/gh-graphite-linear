{
  "manifest_version": 3,
  "name": "GitHub · Graphite · Linear",
  "version": "3.0.0",
  "description": "Cross-links for pull requests: Graphite ↔ GitHub, plus GitHub → Linear Review.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "GitHub · Graphite · Linear",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://app.graphite.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["github-content.js"],
      "css": ["github-content.css"],
      "run_at": "document_idle"
    }
  ]
}
